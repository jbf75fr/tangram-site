{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:page(actions|admin|aide|auth|confidentialite|connexion|croisements|dashboard|decision|evolution|rapport|themes|alertes|churn-config|consommation|copilote-config|design|echelles-notes|journal|prompts|reglages|resume-ia)",
      "destination": "https://app.tangram.cx/:page",
      "permanent": true
    },
    {
      "source": "/:page(actions|admin|aide|auth|confidentialite|connexion|croisements|dashboard|decision|evolution|rapport|themes|alertes|churn-config|consommation|copilote-config|design|echelles-notes|journal|prompts|reglages|resume-ia)/:reste*",
      "destination": "https://app.tangram.cx/:page/:reste*",
      "permanent": true
    },
    {
      "source": "/solution",
      "destination": "/fonctionnalites",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:page([A-Za-z0-9]+).dc(.html)?",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    },
    {
      "source": "/(img|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- public api vercel.json"
}